<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Todos</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="stylesheet" href="/stylesheets/todos.css" />
  <%= javascript_include_tag %w[underscore.js jquery.js backbone.js backpusher.js pusher.js application.js] %>
  <%= csrf_meta_tag %>
  <link rel="shortcut icon" href="/favicon.png" />
  <link rel="apple-touch-icon-precomposed" href="/favicon.png" />
</head>
<body>
  <main id="todoapp" role="main">
    <%= yield %>
  </main>

  <footer>
    <nav id="instructions" aria-label="Project links">
      <p>
        Read the <a href="#" title="Blog post about how this was built">Blog Post</a>
        or <a href="https://github.com/yukikumagai/backbone-todo-app" title="Source code on GitHub">Get The Code</a>.
      </p>
    </nav>

    <section id="credits">
      <p>
        Created by<br />
        <a href="http://jgn.me/" title="Jérôme Gravel-Niquet's website">Jérôme Gravel-Niquet</a>
      </p>
      <p>
        Modified for Realtime by<br />
        <a href="https://pusher.com" title="Pusher: real-time push for web apps">the <em>Pusherinos</em></a>
      </p>
      <p class="wide">
        Icons by <a href="http://somerandomdude.com/projects/iconic/" title="Iconic icon set by @somerandomdude">@somerandomdude</a>.
      </p>
    </section>
  </footer>
</body>
</html>
